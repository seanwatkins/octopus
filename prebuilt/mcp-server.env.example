# /etc/octopus.env
# Octopus appliance runtime configuration.
# Edit this file before building, or on a running appliance.
# All variables are sourced by the init script and all service run scripts.

# ── Identity ──────────────────────────────────────────────────────────────────
HOSTNAME=octopus

# ── Network ───────────────────────────────────────────────────────────────────
NETWORK_INTERFACE=eth0
# Set to "static" to use a fixed IP instead of DHCP
NETWORK_MODE=dhcp
# Only used if NETWORK_MODE=static
STATIC_IP=192.168.1.100
STATIC_NETMASK=255.255.255.0
STATIC_GATEWAY=192.168.1.1

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_SERVER_URL=https://your-tunnel.trycloudflare.com
MCP_PORT=8765
MCP_ROOT=/data/projects
MCP_ENDPOINT=/claude

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Get your token from: https://one.dash.cloudflare.com/
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# ── SSH ───────────────────────────────────────────────────────────────────────
# Paste your public key(s) here (one per line, will be written to authorized_keys)
SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA... your-key-here"

# ── NTP ───────────────────────────────────────────────────────────────────────
NTP_SERVERS="0.pool.ntp.org 1.pool.ntp.org 2.pool.ntp.org"

# ── DNS ───────────────────────────────────────────────────────────────────────
DNS_UPSTREAM=1.1.1.1
DNS_UPSTREAM_SECONDARY=8.8.8.8

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=/var/log/octopus
