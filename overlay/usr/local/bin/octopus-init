#!/bin/sh
# /usr/local/bin/octopus-init
# PID 1 — Stage 1 init for Octopus appliance.
# Mounts filesystems, configures network, writes dynamic configs,
# then execs s6-svscan which supervises all services.

set -e

# ── Essential mounts ──────────────────────────────────────────────────────────
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev
mount -t tmpfs    none /tmp  -o mode=1777
mount -t tmpfs    none /run  -o mode=0755

mkdir -p /dev/pts /dev/shm
mount -t devpts none /dev/pts
mount -t tmpfs  none /dev/shm -o mode=1777

# ── Load environment ──────────────────────────────────────────────────────────
if [ -f /etc/octopus.env ]; then
    set -a
    . /etc/octopus.env
    set +a
fi

# ── Identity ──────────────────────────────────────────────────────────────────
hostname "${HOSTNAME:-octopus}"

cat > /etc/hosts <<EOF
127.0.0.1   localhost ${HOSTNAME:-octopus}
::1         localhost
EOF

# ── Log directories ───────────────────────────────────────────────────────────
mkdir -p "${LOG_DIR:-/var/log/octopus}"
mkdir -p /var/log/octopus/mcp-server
mkdir -p /var/log/octopus/cloudflared
mkdir -p /var/log/octopus/sshd
mkdir -p /var/lib/chrony
mkdir -p /var/lib/unbound

# ── Network ───────────────────────────────────────────────────────────────────
ip link set lo up

if [ "${NETWORK_MODE:-dhcp}" = "static" ]; then
    ip addr add "${STATIC_IP}/${STATIC_NETMASK}" dev "${NETWORK_INTERFACE:-eth0}"
    ip link set "${NETWORK_INTERFACE:-eth0}" up
    ip route add default via "${STATIC_GATEWAY}"
    cat > /etc/resolv.conf <<EOF
nameserver 127.0.0.1
nameserver ${DNS_UPSTREAM:-1.1.1.1}
EOF
else
    # DHCP is handled by the dhcpcd service — just bring the interface up
    ip link set "${NETWORK_INTERFACE:-eth0}" up
fi

# ── SSH authorized keys ───────────────────────────────────────────────────────
if [ -n "${SSH_AUTHORIZED_KEYS}" ]; then
    echo "${SSH_AUTHORIZED_KEYS}" > /etc/ssh/authorized_keys
    chmod 600 /etc/ssh/authorized_keys
fi

# Generate SSH host keys if missing (first boot)
if [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
    ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q
    ssh-keygen -t rsa     -b 4096 -f /etc/ssh/ssh_host_rsa_key -N "" -q
fi

# ── MCP data directory ────────────────────────────────────────────────────────
mkdir -p "${MCP_ROOT:-/data/projects}"

# ── Hand off to s6 ───────────────────────────────────────────────────────────
# This replaces the current process (PID 1).
# s6-svscan will manage all services and handle SIGCHLD.
exec s6-svscan /etc/s6/services
